{
  "manifest_version": 3,
  "name": "さくらWEBメール HTML表示（非公式）",
  "version": "1.4.0",
  "description": "さくらのレンタルサーバのWEBメールで、ソースのまま表示されるHTMLメールを描画して表示します。非公式の拡張機能です。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://secure.sakura.ad.jp/rscontrol/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
